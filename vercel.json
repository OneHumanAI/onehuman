{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{web,sdk,docs,server}/**"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://onehuman-ai.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://onehuman-ai.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/email",
      "schedule": "0 8 * * *"
    }
  ]
}
