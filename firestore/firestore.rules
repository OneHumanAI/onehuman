rules_version = '2';
// onehuman.ai's data is read and written only by the site's own server (server/fire-store.ts, as the onehuman-site
// service account). Browsers never talk to Firestore directly: every client request is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
